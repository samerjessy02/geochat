# ============================================================================
# GeoChat configuration — copy to .env and fill in. See config.py for how each
# variable is consumed. All values below are the built-in defaults.
# ============================================================================

# ---- Databases -------------------------------------------------------------
# PostgreSQL + PostGIS (spatial features + dataset registry)
DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/geochat
# Qdrant (document vectors for RAG)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=geochat_documents
# Client request timeout (s) and upsert batch size — raise the timeout if you
# see "write operation timed out" while ingesting.
QDRANT_TIMEOUT=60
QDRANT_UPSERT_BATCH=64

# ---- LLM provider ----------------------------------------------------------
# One of: groq | anthropic | openai | gemini
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# API key for the selected provider. API_KEY kept for backwards compatibility.
API_KEY=your-groq-api-key
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ---- Embeddings ------------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_PREFIX=query:
EMBEDDING_PASSAGE_PREFIX=passage:

# ---- Chunking --------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# auto = one chunk per heading/section for catalog-style docs (name + paragraph),
# else recursive. Options: auto | heading | recursive
CHUNK_STRATEGY=auto
# PDF extraction: auto = pypdf first, fall back to Docling when the output looks
# scanned/jumbled. Options: auto | pypdf | docling  (docling needs `pip install docling`)
PDF_LOADER=auto
PDF_MIN_CHARS_PER_PAGE=40
PDF_MIN_WHITESPACE_RATIO=0.05

# ---- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
# count / "list all" / negation queries feed the whole document when it has at
# most this many chunks (so the model sees the complete set, not a top-k sample)
EXHAUSTIVE_MAX_CHUNKS=40
DENSE_WEIGHT=1.0
BM25_WEIGHT=1.0
RRF_K=60

# ---- Reranking (optional cross-encoder) ------------------------------------
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Retrieval validation thresholds ---------------------------------------
MIN_CONTEXT_SCORE=0.35
MIN_KEYWORD_OVERLAP=0.05

# ---- Web fallback ----------------------------------------------------------
# Official-website-first web retrieval. Requires a Tavily key for discovery.
WEB_FALLBACK_ENABLED=true
# TAVILY_API_KEY=
WEB_MAX_PAGES=3
# Scraper engine: auto (Firecrawl if FIRECRAWL_API_KEY set, else httpx) | firecrawl | httpx
SCRAPER=auto
# FIRECRAWL_API_KEY=
# Firecrawl API base — v2 is current (v1 is legacy). Only change if the API moves.
# FIRECRAWL_API_BASE=https://api.firecrawl.dev/v2
# Max pages to crawl on the feature's site when the landing page isn't enough,
# and how long (s) to wait for a crawl job to finish.
FIRECRAWL_CRAWL_LIMIT=10
FIRECRAWL_TIMEOUT=90
# Explore the top-N ranked pages and follow up to M of each page's links one
# level deeper (e.g. /menu -> /drinks). CRAWL_LIMIT is the total scrape budget.
FIRECRAWL_TOP_PAGES=3
FIRECRAWL_DEEP_LINKS=2

# ---- Conversational memory -------------------------------------------------
# ConversationBufferWindowMemory: remember the last K interactions (user+reply)
# per session, so follow-ups keep context. Bounded by turn count.
MEMORY_ENABLED=true
MEMORY_WINDOW_K=5
# Rewrite a follow-up into a standalone question using the window before
# retrieval/intent (resolves "it", "that one", etc.). Costs one small LLM call.
MEMORY_CONDENSE=true

# ---- Guardrails ------------------------------------------------------------
GUARDRAILS_ENABLED=true
MAX_QUERY_CHARS=2000

# ---- Evaluation ------------------------------------------------------------
EVALUATION_ENABLED=true
# Reject answers the evaluator judges less than this fraction supported by the
# retrieved context (guards against hallucinated / unsupported facts). 0 disables.
MIN_FAITHFULNESS=0.5

# ---- Logging ---------------------------------------------------------------
# DEBUG shows per-stage detail (scores, counts, SQL, web tier); INFO is a clean
# high-level trace of every step.
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE=geochat.log
LOG_JSON=false
